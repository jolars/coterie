{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssignmentDetail",
  "description": "The unabridged document referenced by an assignment or recovery source.",
  "type": "object",
  "properties": {
    "assignment": {
      "$ref": "#/$defs/AssignmentRecord"
    },
    "recoveries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RecoverySummary"
      }
    },
    "recovery_handoffs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/RecoveryHandoff"
      }
    },
    "workspace": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkspaceDetail"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "assignment",
    "workspace",
    "recoveries",
    "recovery_handoffs"
  ],
  "$defs": {
    "AgentId": {
      "type": "string",
      "pattern": "^cg-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "AssignmentId": {
      "type": "string",
      "pattern": "^ca-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "AssignmentRecord": {
      "description": "The durable association between a task, agent, and eventual workspace.",
      "type": "object",
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/AgentId"
        },
        "claim_id": {
          "type": "integer",
          "format": "int64"
        },
        "completed_at": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "generation": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "$ref": "#/$defs/AssignmentId"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "session_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/SessionId"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        }
      },
      "required": [
        "id",
        "run_id",
        "task_id",
        "agent_id",
        "session_id",
        "claim_id",
        "generation",
        "state",
        "summary",
        "created_at",
        "completed_at"
      ]
    },
    "EvidencePreview": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/TextPreview"
        },
        "text": {
          "$ref": "#/$defs/TextPreview"
        }
      },
      "required": [
        "text",
        "source"
      ]
    },
    "OperationId": {
      "type": "string",
      "pattern": "^co-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "ProjectId": {
      "type": "string",
      "pattern": "^cp-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "RecoveryHandoff": {
      "type": "object",
      "properties": {
        "mechanical": {
          "$ref": "#/$defs/RecoverySnapshot"
        },
        "operation_id": {
          "$ref": "#/$defs/OperationId"
        },
        "recorded_at": {
          "type": "integer",
          "format": "int64"
        },
        "reported": {
          "$ref": "#/$defs/RecoveryReport"
        },
        "reported_by": {
          "description": "None denotes the operator, as in other task records.",
          "anyOf": [
            {
              "$ref": "#/$defs/AgentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_assignment_id": {
          "$ref": "#/$defs/AssignmentId"
        }
      },
      "required": [
        "operation_id",
        "source_assignment_id",
        "recorded_at",
        "reported_by",
        "mechanical",
        "reported"
      ]
    },
    "RecoveryHandoffBrief": {
      "description": "Full details are retrieved with the source assignment ID, not repeated in prime.",
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "conflicted_paths": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "dirty_paths": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "head_commit": {
          "type": "string"
        },
        "hidden_index_paths": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "operation_id": {
          "$ref": "#/$defs/OperationId"
        },
        "operation_in_progress": {
          "type": "boolean"
        },
        "recorded_at": {
          "type": "integer",
          "format": "int64"
        },
        "reported_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_assignment_id": {
          "$ref": "#/$defs/AssignmentId"
        },
        "staged_paths": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "unfinished_step": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidencePreview"
            },
            {
              "type": "null"
            }
          ]
        },
        "unfinished_steps_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "unreadable_paths": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "unstaged_paths": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "untracked_paths": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "validation_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidencePreview"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_evidence_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "operation_id",
        "source_assignment_id",
        "recorded_at",
        "reported_by",
        "head_commit",
        "complete",
        "operation_in_progress",
        "dirty_paths",
        "staged_paths",
        "unstaged_paths",
        "untracked_paths",
        "conflicted_paths",
        "unreadable_paths",
        "hidden_index_paths",
        "validation_evidence_count",
        "unfinished_steps_count",
        "validation_evidence",
        "unfinished_step"
      ]
    },
    "RecoveryPath": {
      "description": "A lossless repository-relative path; display text may replace non-UTF-8 bytes.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "path_bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          }
        }
      },
      "required": [
        "path",
        "path_bytes"
      ]
    },
    "RecoveryReport": {
      "type": "object",
      "properties": {
        "unfinished_steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportedEvidence"
          }
        },
        "validation_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ReportedEvidence"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "validation_evidence",
        "unfinished_steps"
      ]
    },
    "RecoverySnapshot": {
      "type": "object",
      "properties": {
        "complete": {
          "description": "False when unreadable paths or hidden index entries limit the observation.",
          "type": "boolean"
        },
        "conflicted_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecoveryPath"
          }
        },
        "dirty_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecoveryPath"
          }
        },
        "head_commit": {
          "type": "string"
        },
        "hidden_index_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecoveryPath"
          }
        },
        "operation_in_progress": {
          "type": "boolean"
        },
        "staged_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecoveryPath"
          }
        },
        "unreadable_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecoveryPath"
          }
        },
        "unstaged_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecoveryPath"
          }
        },
        "untracked_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RecoveryPath"
          }
        }
      },
      "required": [
        "head_commit",
        "operation_in_progress",
        "complete",
        "dirty_paths",
        "staged_paths",
        "unstaged_paths",
        "untracked_paths",
        "conflicted_paths",
        "unreadable_paths",
        "hidden_index_paths"
      ]
    },
    "RecoverySummary": {
      "description": "Preserved source context and the explicit link to a later assignment.",
      "type": "object",
      "properties": {
        "assignment_id": {
          "$ref": "#/$defs/AssignmentId"
        },
        "base_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "continuation_assignment_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssignmentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "type": "integer",
          "format": "int64"
        },
        "handoff": {
          "description": "Absent for recoveries recorded before handoff snapshots were supported.",
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryHandoffBrief"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "reason": {
          "type": "string"
        },
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "workspace_path": {
          "type": "string"
        },
        "workspace_path_bytes": {
          "description": "Exact native path bytes, including paths that are not UTF-8.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          }
        }
      },
      "required": [
        "task_id",
        "assignment_id",
        "session_id",
        "project_id",
        "generation",
        "workspace_path",
        "workspace_path_bytes",
        "base_commit",
        "reason",
        "continuation_assignment_id"
      ]
    },
    "ReportedEvidence": {
      "description": "A reporter's statement and reference, not a check executed by Coterie.",
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "text",
        "source"
      ]
    },
    "RunId": {
      "type": "string",
      "pattern": "^cr-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "SessionId": {
      "type": "string",
      "pattern": "^cs-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "TaskId": {
      "type": "string",
      "pattern": "^ct-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "TextPreview": {
      "description": "A lossless prefix, explicitly distinguished from the complete stored text.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "total_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "total_bytes",
        "truncated"
      ]
    },
    "WorkspaceDetail": {
      "type": "object",
      "properties": {
        "base_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "path_bytes": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          }
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "result_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_commit": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "project_id",
        "kind",
        "path",
        "path_bytes",
        "base_commit",
        "result_commit",
        "target_commit"
      ]
    }
  }
}
