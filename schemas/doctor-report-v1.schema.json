{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DoctorReport",
  "type": "object",
  "properties": {
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DoctorCheck"
      }
    },
    "run_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/RunId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "checks"
  ],
  "$defs": {
    "CheckStatus": {
      "type": "string",
      "enum": [
        "ok",
        "warning",
        "error",
        "unavailable"
      ]
    },
    "DoctorCheck": {
      "type": "object",
      "properties": {
        "check": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CheckStatus"
        },
        "subject": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "check",
        "status",
        "message"
      ]
    },
    "RunId": {
      "type": "string",
      "pattern": "^cr-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    }
  }
}
