{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Coterie CLI mutation success response v1",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "#/$defs/RecoverySummary"
    },
    "operation_id": {
      "$ref": "#/$defs/OperationId"
    },
    "schema_version": {
      "$ref": "#/$defs/CliSchemaVersion"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "data"
  ],
  "$defs": {
    "AgentId": {
      "type": "string",
      "pattern": "^cg-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "AssignmentId": {
      "type": "string",
      "pattern": "^ca-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "CliSchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "EvidencePreview": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "#/$defs/TextPreview"
        },
        "text": {
          "$ref": "#/$defs/TextPreview"
        }
      },
      "required": [
        "text",
        "source"
      ]
    },
    "OperationId": {
      "type": "string",
      "pattern": "^co-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "ProjectId": {
      "type": "string",
      "pattern": "^cp-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "RecoveryHandoffBrief": {
      "description": "Full details are retrieved with the source assignment ID, not repeated in prime.",
      "type": "object",
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "conflicted_paths": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "dirty_paths": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "head_commit": {
          "type": "string"
        },
        "hidden_index_paths": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "operation_id": {
          "$ref": "#/$defs/OperationId"
        },
        "operation_in_progress": {
          "type": "boolean"
        },
        "recorded_at": {
          "type": "integer",
          "format": "int64"
        },
        "reported_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_assignment_id": {
          "$ref": "#/$defs/AssignmentId"
        },
        "staged_paths": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "unfinished_step": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidencePreview"
            },
            {
              "type": "null"
            }
          ]
        },
        "unfinished_steps_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "unreadable_paths": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "unstaged_paths": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "untracked_paths": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "validation_evidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidencePreview"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_evidence_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "operation_id",
        "source_assignment_id",
        "recorded_at",
        "reported_by",
        "head_commit",
        "complete",
        "operation_in_progress",
        "dirty_paths",
        "staged_paths",
        "unstaged_paths",
        "untracked_paths",
        "conflicted_paths",
        "unreadable_paths",
        "hidden_index_paths",
        "validation_evidence_count",
        "unfinished_steps_count",
        "validation_evidence",
        "unfinished_step"
      ]
    },
    "RecoverySummary": {
      "description": "Preserved source context and the explicit link to a later assignment.",
      "type": "object",
      "properties": {
        "assignment_id": {
          "$ref": "#/$defs/AssignmentId"
        },
        "base_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "continuation_assignment_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssignmentId"
            },
            {
              "type": "null"
            }
          ]
        },
        "generation": {
          "type": "integer",
          "format": "int64"
        },
        "handoff": {
          "description": "Absent for recoveries recorded before handoff snapshots were supported.",
          "anyOf": [
            {
              "$ref": "#/$defs/RecoveryHandoffBrief"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "reason": {
          "type": "string"
        },
        "session_id": {
          "$ref": "#/$defs/SessionId"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        },
        "workspace_path": {
          "type": "string"
        },
        "workspace_path_bytes": {
          "description": "Exact native path bytes, including paths that are not UTF-8.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          }
        }
      },
      "required": [
        "task_id",
        "assignment_id",
        "session_id",
        "project_id",
        "generation",
        "workspace_path",
        "workspace_path_bytes",
        "base_commit",
        "reason",
        "continuation_assignment_id"
      ]
    },
    "SessionId": {
      "type": "string",
      "pattern": "^cs-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "TaskId": {
      "type": "string",
      "pattern": "^ct-[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "TextPreview": {
      "description": "A lossless prefix, explicitly distinguished from the complete stored text.",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "total_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "total_bytes",
        "truncated"
      ]
    }
  }
}
